{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": "build",
      "problemMatcher": "$esbuild",
      "label": "npm: compile",
      "detail": "Bundle src/ into dist/ once"
    },
    {
      "type": "npm",
      "script": "watch",
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": "$esbuild-watch",
      "label": "npm: watch",
      "detail": "Bundle src/ into dist/, rebuilding on change"
    },
    {
      "type": "npm",
      "script": "watch-tests",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "label": "npm: watch-tests",
      "detail": "Compile src/ to out/ for the integration tests"
    },
    {
      "type": "npm",
      "script": "pretest",
      "problemMatcher": ["$tsc", "$esbuild"],
      "label": "npm: pretest",
      "detail": "Everything the integration tests need built"
    }
  ]
}
